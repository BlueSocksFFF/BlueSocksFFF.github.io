source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'

# Windows does not ship the IANA timezone database used by Jekyll.
gem 'tzinfo-data', platforms: [:mingw, :x64_mingw]
